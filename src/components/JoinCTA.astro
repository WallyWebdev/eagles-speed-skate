---
import { SITE } from '../lib/site';
---

<section class="cta" id="join">
  <div class="wrap cta-inner">
    <div>
      <h2>Ready to find<br />your speed?</h2>
      <p>
        Bring your curiosity. The Eagles can help with the next step — whether you are new to
        inline speed skating or ready to race.
      </p>
    </div>
    <a class="button" href={SITE.mainClubUrl} target="_blank" rel="noopener noreferrer">
      Visit the main club website ↗
    </a>
  </div>
</section>
