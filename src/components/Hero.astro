---
import { SITE } from '../lib/site';
---

<section class="hero" id="top">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <div class="eyebrow">{SITE.club}</div>
      <h1>Fly <span>faster.</span><br />Race proud.</h1>
      <p>
        Inline speed skating for athletes who want to build confidence, sharpen technique
        and belong to a team that moves together.
      </p>
      <div class="hero-actions">
        <a class="button" href="#join">Start skating</a>
        <a class="ghost" href="#programs">Explore programs</a>
      </div>
    </div>
    <div
      class="photo-frame"
      role="img"
      aria-label="Photography placeholder for a club inline speed skater in Eagles racing uniform"
    >
      <span class="frame-label">Photography placeholder</span>
      <span class="photo-index">PLACEHOLDER 01 / HERO</span>
      <div class="photo-brief">
        <b>Club inline speed skater in Eagles racing uniform</b>
        <small>
          Suggested shot: low racing stance, full inline skates visible, clean background and
          room for the red diagonal.
        </small>
      </div>
    </div>
  </div>
</section>
