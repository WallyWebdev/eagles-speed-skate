---
import { SITE } from '../lib/site';
---

<section id="try">
  <div class="wrap try-grid">
    <div>
      <div class="eyebrow">First visit</div>
      <h2 class="section-heading">Come and try inline speed skating.</h2>
      <p class="intro">
        New to the sport? We welcome first-timers to a come-and-try session. Before you hit the
        track, you need two things sorted — and if you're not a member yet, there's an easy way to start.
      </p>
      <ul class="checklist">
        <li>Bring your own helmet — it's required to skate</li>
        <li>Be a Skate Australia member</li>
      </ul>
    </div>
    <aside class="trial-card">
      <h3>Not a member yet?</h3>
      <p>Skate Australia offers a free three-week trial so you can hit the track before you commit.</p>
      <a
        class="button"
        href={SITE.skateAustraliaTrialUrl}
        target="_blank"
        rel="noopener noreferrer"
      >Start your 3-week trial ↗</a>
    </aside>
  </div>
</section>
